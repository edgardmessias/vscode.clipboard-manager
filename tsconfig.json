{
    "compilerOptions": {
        "module": "node16",
        "moduleResolution": "node16",
        "esModuleInterop": true,
        "target": "ES2022",
        "outDir": "out",
        "lib": ["ES2022"],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "noUnusedLocals": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "types": ["node", "vitest/globals"]
    },
    "exclude": ["node_modules", ".vscode-test", "out", "dist", "tsdown.config.mts", "vitest.config.mts"]
}
