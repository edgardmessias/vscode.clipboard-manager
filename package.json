{
    "publisher": "EdgardMessias",
    "name": "clipboard-manager",
    "displayName": "Clipboard Manager",
    "description": "Clipboard Manager",
    "version": "1.8.1",
    "icon": "media/clipboard.png",
    "extensionKind": [
        "ui"
    ],
    "engines": {
        "vscode": "^1.97.0"
    },
    "bugs": {
        "url": "https://github.com/edgardmessias/vscode.clipboard-manager/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/edgardmessias/vscode.clipboard-manager.git"
    },
    "homepage": "https://github.com/edgardmessias/vscode.clipboard-manager",
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/edgardmessias"
        },
        {
            "type": "other",
            "url": "https://www.paypal.com/donate/?hosted_button_id=VM8EPZ6EW6UWS"
        },
        {
            "type": "other",
            "url": "https://ko-fi.com/edgardmessias"
        }
    ],
    "categories": [
        "Other"
    ],
    "keywords": [
        "clipboard",
        "copy",
        "ditto",
        "history",
        "paste"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "clipboard-manager",
                    "title": "Clipboard Manager",
                    "icon": "media/clipboard.svg"
                }
            ]
        },
        "views": {
            "clipboard-manager": [
                {
                    "type": "webview",
                    "id": "clipboardHistory",
                    "name": "Clipboard History"
                }
            ]
        },
        "commands": [
            {
                "command": "clipboard-manager.ban.clearAll",
                "title": "Clear Banned Clips",
                "category": "Clipboard Manager"
            },
            {
                "command": "clipboard-manager.ban.unbanLast",
                "title": "Unban Last Banned Clip",
                "category": "Clipboard Manager"
            },
            {
                "command": "clipboard-manager.capture.toggle",
                "title": "Toggle Capture",
                "category": "Clipboard Manager"
            },
            {
                "command": "clipboard-manager.editor.copyToHistory",
                "title": "Copy to Clipboard History",
                "category": "Clipboard Manager"
            },
            {
                "command": "clipboard-manager.editor.pickAndPaste",
                "title": "Pick and Paste",
                "category": "Clipboard Manager"
            },
            {
                "command": "clipboard-manager.editor.showClipboardInFile",
                "title": "Show in the file",
                "category": "Clipboard Manager"
            },
            {
                "command": "clipboard-manager.history.clear",
                "title": "Clear History",
                "category": "Clipboard Manager",
                "icon": {
                    "dark": "resources/dark/clear-history.svg",
                    "light": "resources/light/clear-history.svg"
                }
            },
            {
                "command": "clipboard-manager.history.clearUnpinned",
                "title": "Clear Unpinned History",
                "category": "Clipboard Manager"
            },
            {
                "command": "clipboard-manager.history.remove",
                "title": "Remove",
                "category": "Clipboard Manager",
                "icon": {
                    "dark": "resources/dark/remove.svg",
                    "light": "resources/light/remove.svg"
                }
            },
            {
                "command": "clipboard-manager.statusBar.click",
                "title": "Status Bar Actions",
                "category": "Clipboard Manager"
            },
            {
                "command": "clipboard-manager.ui.togglePinnedToTop",
                "title": "Toggle Pinned to Top",
                "category": "Clipboard Manager"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "clipboard-manager.editor.pickAndPaste",
                    "when": "editorFocus && !editorReadonly"
                },
                {
                    "command": "clipboard-manager.editor.showClipboardInFile",
                    "when": "false"
                },
                {
                    "command": "clipboard-manager.history.clear"
                },
                {
                    "command": "clipboard-manager.history.clearUnpinned"
                },
                {
                    "command": "clipboard-manager.history.remove",
                    "when": "false"
                },
                {
                    "command": "clipboard-manager.statusBar.click",
                    "when": "false"
                },
                {
                    "command": "clipboard-manager.ui.togglePinnedToTop"
                }
            ],
            "view/title": [
                {
                    "command": "clipboard-manager.history.clear",
                    "when": "view == clipboardHistory",
                    "group": "navigation"
                }
            ]
        },
        "keybindings": [
            {
                "command": "clipboard-manager.editor.copyToHistory",
                "key": "Ctrl+Shift+C",
                "mac": "Cmd+Shift+C",
                "when": "textInputFocus && !editorReadonly"
            },
            {
                "command": "clipboard-manager.editor.pickAndPaste",
                "key": "Ctrl+Shift+V",
                "mac": "Cmd+Shift+V",
                "when": "textInputFocus && !editorReadonly"
            }
        ],
        "configuration": [
            {
                "title": "Clipboard Manager",
                "properties": {
                    "clipboard-manager.avoidDuplicates": {
                        "type": "boolean",
                        "default": true,
                        "description": "Avoid duplicate clips in the list"
                    },
                    "clipboard-manager.ban.notifyOnBlock": {
                        "type": "boolean",
                        "default": false,
                        "description": "Show a notification when a banned clip is blocked from being captured. Ban list is stored as content hashes in VS Code SecretStorage (machine-local)."
                    },
                    "clipboard-manager.capture.enabled": {
                        "type": "boolean",
                        "default": true,
                        "description": "When false, automatic clipboard capture is paused. Manual Copy to Clipboard History still works."
                    },
                    "clipboard-manager.checkInterval": {
                        "type": "integer",
                        "default": 500,
                        "description": "Time in milliseconds to check changes in clipboard. Set zero to disable."
                    },
                    "clipboard-manager.exclude.filePatterns": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "description": "Glob patterns; copies from matching files are not saved to history. Uses VS Code-style globs (e.g. **/.env, *.pem). Empty by default."
                    },
                    "clipboard-manager.maxClipboardSize": {
                        "type": "integer",
                        "default": 1000000,
                        "description": "Maximum clipboard size in bytes."
                    },
                    "clipboard-manager.maxClips": {
                        "type": "integer",
                        "default": 100,
                        "description": "Maximum number of clips to save in clipboard"
                    },
                    "clipboard-manager.moveToTop": {
                        "type": "boolean",
                        "default": true,
                        "description": "Move used clip to top in the list"
                    },
                    "clipboard-manager.onlyWindowFocused": {
                        "type": "boolean",
                        "default": true,
                        "description": "Get clips only from VSCode"
                    },
                    "clipboard-manager.preview": {
                        "type": "boolean",
                        "default": true,
                        "description": "View a preview while you are choosing the clip"
                    },
                    "clipboard-manager.saveTo": {
                        "type": [
                            "string",
                            "null",
                            "boolean"
                        ],
                        "default": null,
                        "description": "Set location to save the clipboard file, set false to disable",
                        "scope": "application"
                    },
                    "clipboard-manager.snippet.enabled": {
                        "scope": "resource",
                        "type": "boolean",
                        "default": true,
                        "description": "Enable completion snippets"
                    },
                    "clipboard-manager.snippet.max": {
                        "scope": "resource",
                        "type": "integer",
                        "default": 10,
                        "description": "Maximum number of clips to suggests in snippets (Zero for all)"
                    },
                    "clipboard-manager.snippet.prefix": {
                        "scope": "resource",
                        "type": "string",
                        "default": "clip",
                        "description": "Default prefix for snippets completion (clip1, clip2, ...)"
                    },
                    "clipboard-manager.statusBar.enabled": {
                        "type": "boolean",
                        "default": true,
                        "description": "Show Clipboard Manager status bar item (clip count and capture state)"
                    },
                    "clipboard-manager.ui.pinnedToTop": {
                        "type": "boolean",
                        "default": true,
                        "description": "When enabled, pinned clips appear in a dedicated section at the top. When disabled, pinned clips stay in normal list order."
                    },
                    "clipboard-manager.ui.relativeTime": {
                        "type": "boolean",
                        "default": true,
                        "description": "Show compact relative timestamps in History and Quick Pick (absolute time remains in the tooltip)"
                    }
                }
            }
        ]
    },
    "scripts": {
        "build:webview": "vite build --config webview-ui/vite.config.ts",
        "changelog:last": "conventional-changelog -p angular -r 2 --skip-unstable",
        "changelog:preview": "conventional-changelog -p angular -u --skip-unstable",
        "changelog:update": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0 --skip-unstable",
        "check-types": "tsc --noEmit",
        "clean": "rimraf ./out ./test-reports ./media/clipboard-history",
        "compile": "tsc -p ./ && npm run build:webview",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "lint": "eslint src",
        "organize": "node ./out/tools/organize.js",
        "package": "tsc -p ./ && npm run build:webview",
        "release": "release-it",
        "test": "vitest run",
        "test:e2e": "npm run compile && node ./out/test/runTests.js",
        "vscode:prepublish": "npm run package",
        "vsix": "vsce package -o clipboard-manager.vsix && node ./scripts/verify-vsix.cjs",
        "watch": "concurrently \"npm:watch:ext\" \"npm:watch:webview\"",
        "watch:ext": "tsc -watch -p ./",
        "watch:webview": "vite build --watch --config webview-ui/vite.config.ts"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@types/sinon": "^22.0.0",
        "@types/vscode": "^1.97.0",
        "@vitejs/plugin-react": "^6.0.5",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^3.9.2",
        "concurrently": "^10.0.5",
        "conventional-changelog-cli": "^5.0.0",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "glob": "^13.0.6",
        "mocha": "^11.8.0",
        "ovsx": "^1.1.0",
        "prettier": "^3.9.6",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "release-it": "^21.0.1",
        "rimraf": "^6.1.3",
        "sinon": "^22.1.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "msgpackr": "^2.0.5"
    },
    "overrides": {
        "diff": "^9.0.0",
        "serialize-javascript": "^7.0.7"
    }
}
